    "@texdocx/docx": "workspace:*",
    "@texdocx/math": "workspace:*",
    "@texdocx/model": "workspace:*",
    "@texdocx/validator": "workspace:*",
    "@types/node": "^26.6.4",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
